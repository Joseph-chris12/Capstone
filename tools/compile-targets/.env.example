# Copy to .env and fill in. NEVER commit .env — the service role key bypasses
# every RLS policy and can rewrite the whole gallery.
#
# Both values: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: reuse an existing Chromium instead of Playwright's own download.
# CHROMIUM_PATH=/usr/bin/chromium
