<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default. The AR page is served by the
  in-app localhost server over http://localhost:8080, so that one origin has to
  be permitted.

  Scoped to loopback deliberately rather than setting
  android:usesCleartextTraffic="true", which would permit cleartext to every
  host on the internet. Supabase traffic stays HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
